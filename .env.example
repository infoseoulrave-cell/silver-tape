# TossPayments 결제 연동 키
# 발급: https://developers.tosspayments.com/ → 개발 정보 → API 키
#
# 테스트 키 (test_로 시작)로 먼저 연동 확인 후,
# 프로덕션 키 (live_로 시작)로 전환하세요.

NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_your_client_key_here
TOSS_SECRET_KEY=test_sk_your_secret_key_here
ALLOW_SIMULATED_PAYMENT=false
PAYMENT_ENABLED=false
ORDER_ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
TOSS_WEBHOOK_SECRET=your_toss_webhook_secret_here

# Meta Conversion API (전환 추적)
# 발급: Meta 이벤트 관리자 → 데이터 세트 → 설정 → 전환 API
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here
META_PIXEL_ID=your_pixel_id_here
META_ACCESS_TOKEN=your_meta_access_token_here

# Site Social Links (optional)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your_handle
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your_handle

# Supabase
# 발급: https://supabase.com/ → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solapi (카카오 알림톡)
# 발급: https://solapi.com/ → Developer Hub → API Key
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=          # 카카오 채널 @ID
SOLAPI_SENDER=        # 발신번호
SOLAPI_TPL_ORDER_COMPLETE=    # 주문완료 템플릿 ID
SOLAPI_TPL_DEPOSIT_CONFIRMED= # 입금확인 템플릿 ID
SOLAPI_TPL_SHIPPING_STARTED=  # 배송시작 템플릿 ID

# Sentry
# 발급: https://sentry.io/ → Settings → Client Keys
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Admin
ADMIN_EMAILS=minho@example.com
ADMIN_DASHBOARD_PASSWORD=change_me_strong_password
VENDOR_DASHBOARD_PIN=1234
# VENDOR_DASHBOARD_PASSWORD=1234  # legacy fallback
ADMIN_SESSION_SECRET=replace_with_long_random_string
ADMIN_ALERT_WEBHOOK_URL=
